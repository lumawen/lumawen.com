# Copy to api/.env on the server and fill in. Never commit the real file.
LUMAWEN_ENV=production
LUMAWEN_DATABASE_URL=postgresql+psycopg://lumawen:CHANGE_ME@localhost:5432/lumawen
LUMAWEN_PUBLIC_BASE_URL=https://lumawen.com

# Email. "console" only logs emails; set "smtp" on the server to really send them.
LUMAWEN_MAIL_BACKEND=smtp
LUMAWEN_MAIL_FROM=Lumawen <hello@lumawen.com>
LUMAWEN_SMTP_HOST=smtp.purelymail.com
LUMAWEN_SMTP_PORT=465
LUMAWEN_SMTP_USERNAME=admin@lumawen.com
LUMAWEN_SMTP_PASSWORD=CHANGE_ME

# Google sign-in: the OAuth *web* client ID (Android sign-in in the same Google Cloud project
# also uses it as the audience). Several IDs can be comma-separated; put the web one FIRST,
# since the dashboard's Google button uses the first. Empty = off.
LUMAWEN_GOOGLE_CLIENT_IDS=
